# Thamarayyath Employee Portal - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit the active .env file containing real secrets to version control.

# Application Security (generate a new 50+ character key for production)
DJANGO_SECRET_KEY=generate-a-strong-random-key-here-min-50-characters
DJANGO_DEBUG=False

# Allowed Hosts:
# On PythonAnywhere: your_username.pythonanywhere.com
# For Local/LAN: 127.0.0.1,localhost,192.168.1.100
DJANGO_ALLOWED_HOSTS=your_username.pythonanywhere.com,127.0.0.1,localhost

# CSRF Trusted Origins (include scheme https:// for PythonAnywhere)
DJANGO_CSRF_TRUSTED_ORIGINS=https://your_username.pythonanywhere.com,http://127.0.0.1:8000

# Database Configuration (PythonAnywhere Free Account uses local SQLite only)
DATABASE_URL=sqlite:///db.sqlite3

# Timezone and Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Security Controls
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# Optional Local/LAN Server Configuration (Waitress)
PORTAL_BIND_HOST=0.0.0.0
PORTAL_BIND_PORT=8000
PORTAL_THREADS=8
