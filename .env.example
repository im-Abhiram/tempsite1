# Thamarayyath Employee Portal - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit the active .env file containing real secrets to version control.

# Application Security (generate a new 50+ character key for production)
DJANGO_SECRET_KEY=generate-a-strong-random-key-here-min-50-characters
DJANGO_DEBUG=False

# Allowed Hosts:
# On PythonAnywhere: thamara.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=thamara.pythonanywhere.com,127.0.0.1,localhost

# CSRF Trusted Origins (include scheme https:// for PythonAnywhere)
DJANGO_CSRF_TRUSTED_ORIGINS=https://thamara.pythonanywhere.com,http://127.0.0.1:8000

# Database Configuration (PythonAnywhere Free Account uses local SQLite only)
DATABASE_URL=sqlite:///db.sqlite3

# Timezone and Localization
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Security Controls
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY

# HTTP Security Headers & TLS Configuration
# CSP: dynamic per-request nonce enforced on all scripts. Set to True only for debugging violation reports.
DJANGO_CSP_REPORT_ONLY=False
# COEP: 'unsafe-none' allows external Google Fonts and CDNjs assets without strict CORP headers from their origins.
DJANGO_COEP_POLICY=unsafe-none
# HSTS: Strict-Transport-Security enforced on HTTPS requests (PythonAnywhere edge termination)
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=True
# On PythonAnywhere, HTTPS redirect is best handled by toggling "Force HTTPS" on the Web tab.
DJANGO_SECURE_SSL_REDIRECT=False

